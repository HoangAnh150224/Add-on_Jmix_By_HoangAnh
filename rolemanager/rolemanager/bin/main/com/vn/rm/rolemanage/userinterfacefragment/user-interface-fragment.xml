<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<fragment xmlns="http://jmix.io/schema/flowui/fragment">

    <data>
        <instance id="roleModelDc" class="io.jmix.security.model.ResourceRoleModel">
            <collection id="resourcePoliciesDc" property="resourcePolicies"/>
        </instance>
        <collection id="policyTreeDc" class="com.vn.rm.rolemanage.userinterfacefragment.PolicyGroupNode"/>
    </data>

    <content>
        <vbox id="policyBox" padding="true" spacing="false">
            <hbox spacing="true" alignItems="CENTER">
                <checkbox id="allowAllViews" label="Cho phép tất cả màn hình"/>
            </hbox>
            <h3>Resource Policies (Tree)</h3>
            <treeDataGrid id="policyTreeGrid"
                          dataContainer="policyTreeDc"
                          hierarchyProperty="parent"
                          width="100%"
                          height="100%" themeNames=" small"/>
        </vbox>
    </content>
</fragment>
